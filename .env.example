# ============================================
# Noema Research - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# .env.local is gitignored.

# ============================================
# Database (required)
# ============================================
# Local dev (Docker Postgres — see docker-compose.yml):
DATABASE_URL=postgres://noema:noema_dev@localhost:5432/noema_research

# Production (Neon):
# DATABASE_URL=postgres://<user>:<pass>@<host>.neon.tech/noema_research?sslmode=require

# ============================================
# AI Provider (required — at least one)
# ============================================
# Anthropic Claude (primary for Noema)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (optional — fallback provider)
# GEMINI_API_KEY=...

# Provider selection (default: claude)
AI_PROVIDER=claude
CLAUDE_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-2.5-flash

# ============================================
# Auth / Session (required)
# ============================================
# Password for the standalone researcher login (/login page)
ADMIN_PASSWORD=change-me-for-dev

# Optional dedicated secrets for JWT signing. If unset, ADMIN_PASSWORD is used as fallback.
# Generate with: openssl rand -base64 64
# SESSION_SECRET=
# PARTICIPANT_TOKEN_SECRET=

# ============================================
# Deployment mode
# ============================================
# Noema MVP only supports standalone mode (single-tenant).
DEPLOYMENT_MODE=standalone
